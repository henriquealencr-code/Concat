<?xml version="1.0" encoding="UTF-8"?>
<!--
  Berseker's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.11 -d Root=C:\...\Berseker
              -d Stage=C:\...\stage\Berseker-0.2.11-windows-x86_64
              -o stage\Berseker-0.2.11-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="Berseker"
           Manufacturer="Berseker contributors"
           Version="$(var.Version)"
           UpgradeCode="AD971E66-0461-457C-BD94-10B5F89D7DFA"
           Scope="perMachine"
           Language="1046">
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Berseker já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="berseker.ico" SourceFile="$(var.Root)\assets\icons\berseker.ico" />
    <Property Id="ARPPRODUCTICON" Value="berseker.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/henriquealencr-code/Concat" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Berseker" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="Berseker" />
    </StandardDirectory>

    <Feature Id="Main" Title="Berseker" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="2509A3AA-D88B-47F8-8449-0804DB98F918">
      <Shortcut Id="StartMenuShortcut"
                Name="Berseker"
                Description="Editor de vídeo"
                Target="[INSTALLFOLDER]Berseker.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="berseker.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="Berseker (gráficos seguros)"
                Description="Berseker com renderização por software"
                Target="[INSTALLFOLDER]Berseker.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="berseker.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Berseker" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
